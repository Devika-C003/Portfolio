# Copy this file to .env.local for local development.
# On Vercel: Project → Settings → Environment Variables (same names).

# Gmail account that sends the contact-form emails
SMTP_USER=your.address@gmail.com
# 16-character Gmail App Password (NOT your normal password)
# Create one at https://myaccount.google.com/apppasswords (needs 2-Step Verification on)
SMTP_PASS=xxxxxxxxxxxxxxxx

# Where contact messages are delivered (defaults to SMTP_USER if empty)
CONTACT_TO=

# Optional: override SMTP server (defaults to Gmail)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
